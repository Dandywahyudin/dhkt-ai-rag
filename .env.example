# ==============================================================================
# DHKT AI Service Configuration
# ==============================================================================

# Application
APP_NAME=DHKT AI RAG Service
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=true

# LLM Provider (pilihan: "sumopod" atau "gemini")
LLM_PROVIDER=sumopod

# Sumopod AI (DeepSeek Flash) - https://ai.sumopod.com
# Dapatkan API Key di https://ai.sumopod.com (Tab AI -> API Keys)
SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
SUMOPOD_MODEL=deepseek-v4-flash
SUMOPOD_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini API (Alternatif)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# CodeIgniter 4 HMAC Security
# Samakan secret ini dengan env('AI_INTERNAL_HMAC_SECRET') di CodeIgniter 4
AI_INTERNAL_HMAC_SECRET=dhkt_internal_secret_key_2026
REQUIRE_HMAC=false

# CodeIgniter 4 Tool Calling (mengambil data langsung via Controller CI4)
ENABLE_TOOL_CALLING=true
CI4_BASE_URL=http://127.0.0.1:8080
CI4_TOOL_TIMEOUT_SECONDS=10
HMAC_MAX_SKEW_SECONDS=300

# Vector Store (pilihan: local / qdrant)
# 'local' menyimpan vector ke file JSON/Numpy di storage/index (tanpa perlu docker/service luar)
# 'qdrant' menggunakan Qdrant Vector DB jika ada service docker Qdrant
VECTOR_STORE_BACKEND=local
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=dhkt_knowledge

# RAG & Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RESULTS=4
MIN_SIMILARITY_SCORE=0.3
